# Root-level environment variable reference.
# See frontend/.env.example for the frontend-specific variable (VITE_API_URL).
# Never commit a real .env file — this file contains placeholder values only.

# ── AI / Claude ──────────────────────────────────────────────────────────────
# Required for POST /brief (Day Brief feature) and the daily email scheduler.
# Set this in your Railway environment variables dashboard.
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Daily Email (Phase 2) ─────────────────────────────────────────────────────
# Required for the 07:00 Eastern scheduled email delivery.
# Not needed to run the app locally or to use the on-demand Day Brief button.

# Gmail address that sends the email (must match EMAIL_APP_PASSWORD below)
EMAIL_FROM=your_gmail_address@gmail.com

# Gmail App Password — NOT your regular Gmail password.
# How to get one: Google Account → Security → 2-Step Verification → App Passwords
# 2FA must be enabled on the sending Gmail account.
EMAIL_APP_PASSWORD=your_16_char_app_password

# Recipient address — who receives the 07:00 brief email
EMAIL_TO=recipient@example.com
