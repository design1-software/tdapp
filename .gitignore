# ── Python / Backend ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
venv/
.venv/
env/
*.egg-info/
dist/
build/
backend/tasks.db       # Live database — never commit real data

# ── Node / Frontend ───────────────────────────────────────────
node_modules/
frontend/dist/         # Built output — regenerated by npm run build
frontend/.env          # Real env file — contains API URL, never commit

# ── Environment / Secrets ─────────────────────────────────────
.env
.env.local
.env.production
# .env.example is intentionally NOT ignored — it's a safe template

# ── Editor / OS ───────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
