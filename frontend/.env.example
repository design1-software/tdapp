# 📘 Copy this file to .env before running the frontend locally:
#   cp .env.example .env
#
# VITE_API_URL tells the React app where to send API requests.
# For local development, the FastAPI backend runs at http://localhost:8000.
# For production (Netlify), update this to your Railway deployment URL.
#
# IMPORTANT: Variables must start with VITE_ to be accessible in React code.
# 🔗 Vite env variables: https://vitejs.dev/guide/env-and-mode

VITE_API_URL=http://localhost:8000
